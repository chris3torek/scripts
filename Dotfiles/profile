# sh/bash settings for login shells, bash and plain-sh.
# Note that since we are the login shell, $SHELL is
# either bash or sh; we can also use $0, which works in
# non-login shell (useful for testing).

export HOSTOS=$(uname -s)
export HOSTARCH=$(uname -m)

export BLOCKSIZE=K
export EDITOR=vim
export VISUAL=vim
export PAGER=more # overridden below with less if appropriate

# set TERM=dumb if there's nothing better, just so that $TERM is set
: "${TERM:=dumb}"

# if we have a private terminfo for this, use it;
# if we have a private termcap, use it.  Maybe only set TERMCAP
# if we're really going to use it (ancient systems)?
[ -r "$HOME/.terminfo/$TERM.tinfo" ] && export TERMINFO=$HOME/.terminfo
case "$TERM" in
	xterm|xterm-color|xterm-256color) export TERMCAP=$HOME/.termcap
esac

[ -d $HOME/go ] && export GOPATH=$HOME/go

. $HOME/.sh-common
resetpathwith

case $0 in
*bash) shell-is-bash() { true; }; export BASH_ENV=$HOME/.bashrc;;
*) shell-is-bash() { false; }; export ENV=$HOME/.shrc;;
esac

# Try to borrow an existing ssh agent if we can find one
ssh_activate() {
	local d
	# Note that at most one of these patterns will match
	# some files / directories.  The "new" ssh uses the
	# $HOME/.ssh/agent/s.* files, the old one uses files
	# in /tmp/ssh-* directories.  We want to skip an
	# unexpanded literal asterisk, and also anything that
	# doesn't quite seem right.
	for d in $HOME/.ssh/agent/s.* /tmp/ssh-*; do
		case "$d" in
		"$HOME/.ssh/agent/s.*") continue;;
		"$HOME"/.ssh/agent/*) set "$d";;
		"/tmp/ssh-*") continue;;
		/tmp/ssh/*) set "$d"/agent.*;;
		*) echo "ssh_activate: skipping mysterious entity $d" 1>&2;;
		esac
		# At this point, we should have one positional argument
		# that is the SSH socket.  Let's probe it.
		if [ $# = 1 ]; then
			# ssh-add -l exits 0 or 1 if it works,
			# and 2 if it cannot reach the agent.
			SSH_AUTH_SOCK="$1" ssh-add -l >/dev/null 2>&1
			case $? in
			0|1)
				echo "borrowing SSH agent via $1"
				export SSH_AUTH_SOCK="$1"
				return 0;;
			esac
		fi
	done
	_stop_ssh_on_logout=yes
	eval `ssh-agent -s`
}

case "${SSH_AUTH_SOCK:+set}" in
set) ;;
*) ssh_activate;;
esac

# bash and sh use "type" a bit differently, but both will
# exit 0 if the command exists (or is an alias).
command_exists() {
	type "$1" >/dev/null 2>&1
}

# if less exists, use it as pager; if lesspipe exists, set its env too
command_exists less && {
	export PAGER=less
	export LESS=FRX
	command_exists lesspipe && eval $(lesspipe)
}

# use private termcap file, if using termcap and exists
[ -f $HOME/.termcap ] && export TERMCAP=$HOME/.termcap

# FreeBSD, MacOS: set stty-status control character
if [ -t 0 ]; then
	if stty -a | grep status >/dev/null; then
		stty status ^T
	fi
fi

# Default to UTF-8
export LANG=en_US.UTF-8

# get color settings
. $HOME/.shell_colors

# source .bashrc or .shrc
shell-is-bash && source $HOME/.bashrc
shell-is-bash || . $HOME/.shrc

# install Ruby Gems to ~/gems
export GEM_HOME=$HOME/gems
